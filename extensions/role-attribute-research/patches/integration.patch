+def read_worker_ack(path,timeout=2):
+    """Wait until the native marker has been closed and is readable.
+
+    Windows can publish the directory entry just before the native writer
+    closes its handle. Antivirus scanners can widen that short sharing race.
+    """
+    path=Path(path);deadline=time.monotonic()+timeout;last_error=None
+    while True:
+        try:
+            ack=json.loads(path.read_text(encoding='utf8'))
+            if not isinstance(ack,dict):raise ValueError('原生释放标记必须是对象')
+            if last_error is not None:
+                ack={**ack,'marker_read_recovered':True,'marker_read_error':type(last_error).__name__}
+            return ack
+        except (PermissionError,json.JSONDecodeError,UnicodeDecodeError)as error:
+            last_error=error
+            if time.monotonic()>=deadline:
+                raise
+            time.sleep(.01)
+
