+def verify_release_profile(profile, metadata):
+    """Match every official comparison byte to checked-in public hashes."""
+    normalized = copy.deepcopy(profile)
+    for row in normalized['ranges']:
+        if 'hex' in row:
+            raw = bytes.fromhex(row.pop('hex'))
+            row.update(size=len(raw), sha256=hashlib.sha256(raw).hexdigest())
+    if normalized != metadata:
+        raise ValueError('Official profile does not match checked-in metadata')
+
+
+def generate_from_release(executable, platform='steam'):
+    from io import BytesIO
+    from zipfile import ZipFile
+    from repackage_release import verified_payload
+    prefix, _ = adapter_paths(platform)
+    metadata = json.loads((ROOT / 'native' / (prefix + 'profile_metadata.json')).read_text(encoding='utf8'))
+    with ZipFile(BytesIO(verified_payload(Path(executable).read_bytes(), platform))) as archive:
+        profile = json.loads(archive.read('engine/fm27_native/engine_compat_profile.json'))
+    verify_release_profile(profile, metadata)
+    write_profile(profile, platform)
+    print('Generated private contract from verified official release and public range hashes.')
+
+
